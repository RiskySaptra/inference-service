# Default model to load on startup
MODEL_PATH=models/v1.pt

# Device to use for inference (e.g., "cpu", "cuda")
DEVICE=cuda

# Directory to save images from inference requests
INFERENCE_IMAGES_PATH=inference_images

# Directory to store datasets for retraining
DATASETS_PATH=datasets

# Your secret API key for accessing the API
API_KEY=your-secret-api-key

# Path to the retraining jobs database file (inside the container)
DATABASE_URL=/app/data/retraining_jobs.db